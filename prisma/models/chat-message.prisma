model ChatMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String
  sender    String
  role      String   @default("user")
  content   String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([senderId])
}
